---
import { Image } from "astro:assets";
import { siteData } from "../../data/siteData";
import logoImg from "../../assets/instituto-pega-a-visao-logo.png";
import Container from "../common/Container.astro";
import Button from "../common/Button.astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="bg-zinc-950 border-t border-zinc-800/80 pt-16 pb-12 text-zinc-400 font-sans"
>
  <Container size="lg">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-8 pb-12 border-b border-zinc-800/60"
    >
      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 group">
          <Image
            src={logoImg}
            alt="Instituto Pega a Visão Logo"
            class="h-12 w-auto object-contain"
          />
          <div class="flex flex-col leading-none">
            <span
              class="font-heading font-bold text-xl text-white tracking-wide uppercase"
              >Pega a Visão</span
            >
            <span
              class="text-xs text-orange-500 font-sans tracking-wider uppercase font-semibold"
              >Instituto Social</span
            >
          </div>
        </a>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-sm">
          {siteData.description}
        </p>
        <div class="pt-2 flex items-center space-x-3">
          <a
            href={siteData.contact.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-orange-500 hover:border-orange-500/50 transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <!-- <div class="space-y-3">
        <h3 class="font-heading text-sm uppercase tracking-wider font-semibold text-white">Navegação</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-orange-500 transition-colors">Home</a></li>
          <li><a href="/quem-somos" class="hover:text-orange-500 transition-colors">Quem Somos</a></li>
          <li><a href="/o-que-fazemos" class="hover:text-orange-500 transition-colors">O Que Fazemos</a></li>
          <li><a href="/projetos" class="hover:text-orange-500 transition-colors">Projetos</a></li>
          <li><a href="/equipe" class="hover:text-orange-500 transition-colors">Equipe</a></li>
        </ul>
      </div> -->

      <!-- Institutional Links -->
      <!-- <div class="space-y-3">
        <h3
          class="font-heading text-sm uppercase tracking-wider font-semibold text-white"
        >
          Institucional
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/transparencia"
              class="hover:text-orange-500 transition-colors">Transparência</a>
          </li>
          <li>
            <a href="/parcerias" class="hover:text-orange-500 transition-colors"
              >Parcerias</a>
          </li>
          <li>
            <a href="/contato" class="hover:text-orange-500 transition-colors"
              >Contato</a>
          </li>
          <li>
            <a
              href="/doacoes"
              class="hover:text-orange-500 transition-colors text-orange-400 font-medium"
              >Doações PIX</a>
          </li>
        </ul>
      </div> -->

      <!-- Contact Info -->
      <div class="space-y-3">
        <h3
          class="font-heading text-sm uppercase tracking-wider font-semibold text-white"
        >
          Contato
        </h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 text-orange-500 mt-1 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            <span>{siteData.contact.address}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-orange-500 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            <a
              href={`mailto:${siteData.contact.email}`}
              class="hover:text-orange-500 transition-colors"
              >{siteData.contact.email}</a
            >
          </li>
        </ul>
        <!--<div class="pt-2">
          <Button href="/doacoes" variant="primary" size="sm" class="w-full">
            Apoie Nossos Projetos
          </Button>
        </div>-->
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 border-t border-zinc-800/60"
    >
      <p>© {currentYear} {siteData.name}. Todos os direitos reservados.</p>
      <p class="text-zinc-500 flex items-center gap-1.5">
        Desenvolvido por
        <a
          href="https://www.linkedin.com/in/douglas-paz-b19a61158/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-300 hover:text-orange-500 transition-colors font-medium inline-flex items-center gap-1 group"
        >
          <span>Douglas Paz</span>
          <svg
            class="w-3.5 h-3.5 text-zinc-400 group-hover:text-orange-500 transition-colors"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.7a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"
            ></path>
          </svg>
        </a>
      </p>
    </div>
  </Container>
</footer>
