---
interface Props {
  class?: string;
  hoverEffect?: boolean;
  [key: string]: any;
}

const { class: className = '', hoverEffect = true, ...rest } = Astro.props;

const hoverClasses = hoverEffect
  ? 'hover:border-zinc-700 hover:bg-zinc-900/90 hover:-translate-y-1 transition-all duration-300 shadow-xl shadow-black/40'
  : '';
---

<div
  class={`bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-6 sm:p-8 backdrop-blur-sm ${hoverClasses} ${className}`}
  {...rest}
>
  <slot />
</div>
