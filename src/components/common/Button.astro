---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  id,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-heading font-medium tracking-wide transition-all duration-300 focus:outline-none rounded-lg group select-none active:scale-[0.98]';

const variants = {
  primary: 'bg-orange-600 text-white hover:bg-orange-500 shadow-lg shadow-orange-950/40 border border-orange-500/30 hover:shadow-orange-600/30',
  secondary: 'bg-zinc-800 text-zinc-100 hover:bg-zinc-700 border border-zinc-700/60 hover:border-zinc-500',
  outline: 'bg-transparent text-zinc-100 border border-zinc-700 hover:border-orange-500 hover:text-orange-400',
  ghost: 'bg-transparent text-zinc-400 hover:text-white hover:bg-zinc-900/80',
};

const sizes = {
  sm: 'text-xs px-3.5 py-1.5 gap-1.5',
  md: 'text-sm px-5 py-2.5 gap-2',
  lg: 'text-base px-7 py-3.5 gap-2.5',
};

const combinedClasses = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClasses} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClasses} id={id} {...rest}>
      <slot />
    </button>
  )
}
