---
interface Props {
  variant?: 'orange' | 'zinc' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'orange',
  size = 'md',
  class: className = '',
} = Astro.props;

const baseStyles = 'inline-flex items-center font-heading uppercase tracking-wider font-semibold rounded-full';

const variants = {
  orange: 'bg-orange-950/60 text-orange-400 border border-orange-600/40',
  zinc: 'bg-zinc-800/80 text-zinc-300 border border-zinc-700/60',
  outline: 'bg-transparent text-zinc-400 border border-zinc-700/80',
};

const sizes = {
  sm: 'text-[10px] px-2.5 py-0.5 gap-1',
  md: 'text-xs px-3 py-1 gap-1.5',
};
---

<span class={`${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`}>
  <slot />
</span>
