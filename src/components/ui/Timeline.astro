---
import { timelineData } from '../../data/partnersData';
import Badge from '../common/Badge.astro';
---

<div class="relative border-l-2 border-zinc-800 ml-4 sm:ml-8 space-y-12 py-4">
  {timelineData.map((item) => (
    <div class="relative pl-8 sm:pl-10 group">
      <!-- Dot indicator -->
      <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-zinc-900 border-2 border-orange-500 group-hover:bg-orange-600 transition-colors"></div>
      
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-6 hover:border-zinc-700 transition-colors">
        <div class="flex flex-wrap items-center gap-3 mb-2">
          <span class="text-xl sm:text-2xl font-bold font-heading text-orange-500">{item.year}</span>
          {item.badge && <Badge variant="zinc">{item.badge}</Badge>}
        </div>
        <h3 class="text-lg font-bold font-heading text-white mb-2">{item.title}</h3>
        <p class="text-sm text-zinc-400 font-sans leading-relaxed">{item.description}</p>
      </div>
    </div>
  ))}
</div>
