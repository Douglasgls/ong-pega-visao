---
import Container from "../common/Container.astro";

interface Stat {
  value: string;
  label: string;
  description: string;
}

const stats: Stat[] = [
  {
    value: "+5.000",
    label: "Jovens Atendidos",
    description:
      "Participantes diretos em nossas oficinas e eventos comunitários.",
  },
  {
    value: "+45",
    label: "Apresentações Culturais",
    description: "Espetáculos da Trupe em praças, escolas e teatros de rua.",
  },
  {
    value: "+120",
    label: "Oficinas Gratuitas",
    description:
      "Atividades de formação artística, cidadania e expressão oral.",
  },
  {
    value: "100%",
    label: "Gratuito & Periférico",
    description:
      "Acesso totalmente livre a todas as iniciativas para a comunidade.",
  },
];
---

