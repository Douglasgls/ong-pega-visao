---
import { Image } from "astro:assets";
import type { Project } from "../../types";
import Badge from "../common/Badge.astro";
import Button from "../common/Button.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl overflow-hidden hover:border-zinc-700 transition-all duration-300 flex flex-col h-full group shadow-xl"
>
  <!-- Image Header -->
  <div class="relative h-60 w-full overflow-hidden bg-zinc-950">
    <Image
      src={project.image}
      alt={project.title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute top-4 left-4">
      <Badge variant="orange">{project.category}</Badge>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 sm:p-8 flex flex-col flex-1 justify-between space-y-6">
    <div class="space-y-3">
      <h3
        class="text-xl sm:text-2xl font-bold font-heading text-white group-hover:text-orange-400 transition-colors"
      >
        {project.title}
      </h3>
      <p class="text-sm text-zinc-300 font-sans leading-relaxed">
        {project.summary}
      </p>

