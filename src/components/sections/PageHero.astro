---
import Container from '../common/Container.astro';
import Badge from '../common/Badge.astro';

interface Props {
  badge?: string;
  title: string;
  description?: string;
}

const { badge, title, description } = Astro.props;
---

<section class="relative bg-zinc-950 py-16 sm:py-20 border-b border-zinc-800/80 overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-orange-600/10 rounded-full filter blur-3xl pointer-events-none"></div>
  
  <Container size="lg" class="relative z-10">
    <div class="max-w-3xl space-y-4">
      {badge && (
        <div>
          <Badge variant="orange" size="md">{badge}</Badge>
        </div>
      )}
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-heading text-white tracking-tight leading-tight">
        {title}
      </h1>
      {description && (
        <p class="text-base sm:text-lg text-zinc-300 font-sans leading-relaxed">
          {description}
        </p>
      )}
    </div>
  </Container>
</section>
