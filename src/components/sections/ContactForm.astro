---
import Button from "../common/Button.astro";
---

<div
  class="bg-zinc-900/60 border border-zinc-800/80 rounded-3xl p-6 sm:p-10 shadow-2xl"
>
  <form id="contact-form" class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label
          for="name"
          class="block text-xs font-heading font-semibold uppercase tracking-wider text-zinc-300"
        >
          Seu Nome *
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Ex: Carlos Silva"
          class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-base text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 transition-colors"
        />
      </div>

      <div class="space-y-2">
        <label
          for="email"
          class="block text-xs font-heading font-semibold uppercase tracking-wider text-zinc-300"
        >
          E-mail *
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="exemplo@email.com"
          class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-base text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 transition-colors"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label
          for="phone"
          class="block text-xs font-heading font-semibold uppercase tracking-wider text-zinc-300"
        >
          Telefone / WhatsApp
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="(11) 99999-9999"
          class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-base text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 transition-colors"
        />
      </div>

      <div class="space-y-2">
        <label
          for="subject"
          class="block text-xs font-heading font-semibold uppercase tracking-wider text-zinc-300"
        >
          Assunto
        </label>
        <select
          id="subject"
          name="subject"
          class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-base text-white focus:outline-none focus:border-orange-500 transition-colors"
        >
          <option value="duvidas">Dúvidas gerais</option>
          <option value="nova-parceria">Nova Parceria</option>
          <option value="voluntariado">Voluntariado / Participação</option>
          <option value="imprensa">Imprensa / Mídia</option>
        </select>
      </div>
    </div>

    <div class="space-y-2">
      <label
        for="message"
        class="block text-xs font-heading font-semibold uppercase tracking-wider text-zinc-300"
      >
        Sua Mensagem *
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder="Escreva sua mensagem aqui..."
        class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-base text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 transition-colors resize-none"
      ></textarea>
    </div>

    <div>
      <Button
        type="submit"
        variant="primary"
        size="lg"
        class="w-full sm:w-auto text-center justify-center"
      >
        Enviar Mensagem
      </Button>
    </div>

    <div
      id="form-feedback"
      class="hidden p-4 rounded-xl bg-orange-950/40 border border-orange-500/40 text-orange-300 text-sm font-medium"
    >
      Obrigado pelo contato! Sua mensagem foi enviada com sucesso. Retornaremos
      em breve.
    </div>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const feedback = document.getElementById("form-feedback");
    const subjectSelect = document.getElementById("subject") as HTMLSelectElement;

    // Check query parameter ?assunto=nova-parceria
    const urlParams = new URLSearchParams(window.location.search);
    const assuntoParam = urlParams.get("assunto");
    if (assuntoParam && subjectSelect) {
      if (assuntoParam === "nova-parceria" || assuntoParam === "parceria") {
        subjectSelect.value = "nova-parceria";
      }
    }

    // Se o formulário não existir na página, não faz nada
    if (!form) return;

    // Remove event listeners antigos se existirem (para evitar duplicidade no ViewTransitions)
    form.replaceWith(form.cloneNode(true));
    const newForm = document.getElementById("contact-form") as HTMLFormElement;
    const newFeedback = document.getElementById("form-feedback");

    newForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const accessKey = "607557a0-28f5-4f06-a367-c8524bd8eb62";

      const formData = new FormData(newForm);
      formData.append("access_key", accessKey);

      const submitBtn = newForm.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn?.textContent || "Enviar Mensagem";
      if (submitBtn) submitBtn.textContent = "Enviando...";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          if (newFeedback) {
            newFeedback.classList.remove("hidden");
            newFeedback.classList.remove(
              "bg-red-950/40",
              "border-red-500/40",
              "text-red-300",
            );
            newFeedback.classList.add(
              "bg-orange-950/40",
              "border-orange-500/40",
              "text-orange-300",
            );
            newFeedback.textContent =
              "Obrigado pelo contato! Sua mensagem foi enviada com sucesso. Retornaremos em breve.";
            newForm.reset();
          }
        } else {
          throw new Error(data.message || "Erro ao enviar.");
        }
      } catch (error) {
        if (newFeedback) {
          newFeedback.classList.remove("hidden");
          newFeedback.classList.remove(
            "bg-orange-950/40",
            "border-orange-500/40",
            "text-orange-300",
          );
          newFeedback.classList.add(
            "bg-red-950/40",
            "border-red-500/40",
            "text-red-300",
          );
          newFeedback.textContent =
            "Ocorreu um erro ao enviar sua mensagem. Por favor, tente novamente mais tarde.";
        }
      } finally {
        if (submitBtn) submitBtn.textContent = originalBtnText;
      }
    });
  }

  // Executa na carga inicial e também nas navegações (ViewTransitions)
  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>
