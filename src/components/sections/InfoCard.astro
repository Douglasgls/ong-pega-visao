---
interface Props {
  label: string;
  value: string;
  class?: string;
}

const { label, value, class: className = '' } = Astro.props;
---

<div class={`bg-zinc-900/80 border border-zinc-800/80 rounded-3xl p-6 sm:p-8 hover:border-zinc-700 transition-all duration-300 group flex flex-col justify-between space-y-4 ${className}`}>
  <div class="flex items-center justify-between">
    <span class="text-xs font-heading font-semibold text-zinc-400 uppercase tracking-wider">{label}</span>
    <div class="w-10 h-10 rounded-2xl bg-zinc-950 border border-zinc-800 flex items-center justify-center text-orange-500 group-hover:border-orange-500/40 group-hover:bg-orange-950/30 transition-colors">
      <slot name="icon" />
    </div>
  </div>

  <div>
    <p class="text-base sm:text-lg font-bold font-heading text-white leading-snug group-hover:text-zinc-100 transition-colors">
      {value}
    </p>
  </div>
</div>
