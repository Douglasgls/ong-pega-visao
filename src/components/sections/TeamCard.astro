---
import { Image } from 'astro:assets';
import type { TeamMember } from '../../types';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<article class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl overflow-hidden hover:border-zinc-700 transition-all duration-300 group shadow-lg flex flex-col h-full">
  <div class="relative h-72 sm:h-80 w-full overflow-hidden bg-zinc-950">
    <Image
      src={member.image}
      alt={member.name}
      class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent"></div>
  </div>

  <div class="p-6 flex flex-col flex-1 justify-between space-y-4">
    <div>
      <h3 class="text-xl font-bold font-heading text-white">{member.name}</h3>
      <p class="text-xs font-heading font-semibold text-orange-400 uppercase tracking-wider mt-1">{member.role}</p>
      <p class="text-xs sm:text-sm text-zinc-300 font-sans leading-relaxed mt-3">{member.bio}</p>
    </div>

    {member.socialLinks && (
      <div class="pt-4 border-t border-zinc-800/60 flex items-center gap-3">
        {member.socialLinks.instagram && (
          <a
            href={member.socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-orange-500 transition-colors p-1"
            aria-label={`Instagram de ${member.name}`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        )}
        {member.socialLinks.linkedin && (
          <a
            href={member.socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-orange-500 transition-colors p-1"
            aria-label={`LinkedIn de ${member.name}`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.7a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
          </a>
        )}
        {member.socialLinks.email && (
          <a
            href={`mailto:${member.socialLinks.email}`}
            class="text-zinc-400 hover:text-orange-500 transition-colors p-1"
            aria-label={`E-mail de ${member.name}`}
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
        )}
      </div>
    )}
  </div>
</article>
