---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from '../common/Badge.astro';

interface Props {
  title: string;
  category?: string;
  description: string;
  image: ImageMetadata;
  class?: string;
}

const { title, category, description, image, class: className = '' } = Astro.props;
---

<article class={`bg-zinc-900/80 border border-zinc-800/80 rounded-3xl overflow-hidden hover:border-zinc-700 transition-all duration-500 group shadow-xl flex flex-col h-full ${className}`}>
  <div class="relative h-64 sm:h-72 w-full overflow-hidden bg-zinc-950">
    <Image
      src={image}
      alt={title}
      class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
    {category && (
      <div class="absolute top-4 left-4">
        <Badge variant="zinc" size="sm">{category}</Badge>
      </div>
    )}
  </div>

  <div class="p-6 sm:p-8 flex flex-col flex-1 justify-between space-y-4">
    <div class="space-y-3">
      <h3 class="text-xl sm:text-2xl font-bold font-heading text-white group-hover:text-orange-400 transition-colors">
        {title}
      </h3>
      <p class="text-sm text-zinc-300 font-sans leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</article>
