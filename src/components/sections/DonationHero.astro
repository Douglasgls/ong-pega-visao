---
import { Image } from "astro:assets";
import Container from "../common/Container.astro";
import Badge from "../common/Badge.astro";
import heroImg from "../../assets/galeria/reconectar-e-resistir-6-768x960.png";
---

<section class="relative bg-zinc-950 border-b border-zinc-800/80 overflow-hidden">
  <!-- Subtle ambient background glow -->
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] bg-orange-600/10 rounded-full filter blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-zinc-800/20 rounded-full filter blur-3xl pointer-events-none"
  >
  </div>

  <Container size="lg" class="relative z-10 pt-20 sm:pt-24 lg:pt-28 pb-12 sm:pb-16 lg:pb-20">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center"
    >
      <!-- LEFT COLUMN: Foto de Impacto Completa (reconectar-e-resistir-6-768x960) -->
      <div class="lg:col-span-6 relative order-2 lg:order-1">
        <div class="relative max-w-sm sm:max-w-md mx-auto lg:max-w-none">
          <!-- Moldura moderna e refinada -->
          <div
            class="relative rounded-3xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-2xl shadow-orange-950/20 group"
          >
            <Image
              src={heroImg}
              alt="Juventude e Arte Urbana — Instituto Pega a Visão"
              class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Texto Inspirador & Botão de Apoio (Estilo Charity/Impact) -->
      <div class="lg:col-span-6 space-y-5 sm:space-y-8 order-1 lg:order-2">
        <div class="space-y-3">
          <Badge variant="orange" size="md">Faça Parte da Mudança</Badge>

          <h1
            class="text-2xl sm:text-4xl xl:text-5xl font-bold font-heading text-white tracking-tight leading-[1.15]"
          >
            Cada jovem merece a chance de <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 via-orange-400 to-amber-500">reescrever</span> a sua história.
          </h1>
        </div>

        <p class="text-sm sm:text-base lg:text-lg text-zinc-300 font-sans leading-relaxed">
          Na periferia de São Paulo, o Instituto Pega Visão atua com adolescentes e jovens através da arte, cultura urbana, esportes e acolhimento socioemocional. O seu apoio fortalece oficinas contínuas e abre caminhos reais de autonomia e cidadania.
        </p>

        <!-- Botão de Ação Direto (Scroll Suave) -->
        <div class="pt-2">
          <a
            href="#formas-de-doar"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-orange-600 hover:bg-orange-500 text-white font-heading font-bold text-base sm:text-lg rounded-2xl transition-all duration-300 shadow-xl shadow-orange-600/30 hover:shadow-orange-600/50 active:scale-[0.98] cursor-pointer"
          >
            <span>Apoiar o Instituto</span>
            <svg
              class="w-5 h-5 animate-bounce"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"
              ></path>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </Container>
</section>
