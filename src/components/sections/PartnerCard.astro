---
interface Props {
  name: string;
  description: string;
  class?: string;
}

const { name, description, class: className = '' } = Astro.props;
---

<div class={`bg-zinc-900/80 border border-zinc-800/80 rounded-3xl p-8 sm:p-10 hover:border-zinc-700 transition-all duration-500 group flex flex-col justify-between h-full shadow-xl ${className}`}>
  <div class="space-y-4">
    <h3 class="text-2xl sm:text-3xl font-bold font-heading text-white group-hover:text-orange-500 transition-colors tracking-tight">
      {name}
    </h3>
    <p class="text-base sm:text-lg text-zinc-300 font-sans leading-relaxed">
      {description}
    </p>
  </div>
</div>
