---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  description?: string;
  logo?: ImageMetadata;
  logoWhiteBg?: boolean;
  logoFit?: 'contain' | 'cover';
  hideLogoBox?: boolean;
  link?: string;
  websiteLink?: string;
  class?: string;
}

const {
  name,
  description,
  logo,
  logoWhiteBg = false,
  logoFit = 'contain',
  hideLogoBox = false,
  link,
  websiteLink,
  class: className = ''
} = Astro.props;
---

<div class={`bg-zinc-900/80 border border-zinc-800/80 rounded-3xl p-6 sm:p-8 hover:border-zinc-700 transition-all duration-500 group flex flex-col justify-between h-full shadow-xl ${className}`}>
  <div class="space-y-5">
    <!-- Header com Logo ou Container Cinza Placeholder -->
    <div class="flex items-center justify-between gap-4">
      {logo ? (
        <div class={`h-14 w-32 rounded-2xl ${logoFit === 'cover' ? 'p-0' : 'p-2'} flex items-center justify-center overflow-hidden ${logoWhiteBg ? 'bg-white border border-white' : 'bg-zinc-950/80 border border-zinc-800/80'}`}>
          <Image
            src={logo}
            alt={`Logo ${name}`}
            class={`w-full h-full ${logoFit === 'cover' ? 'object-cover scale-125' : 'max-h-full max-w-full object-contain'}`}
          />
        </div>
      ) : hideLogoBox ? null : (
        <div class="h-14 w-28 bg-zinc-800/40 border border-zinc-700/40 border-dashed rounded-2xl flex items-center justify-center text-zinc-500 text-xs font-sans">
          <span>Logo</span>
        </div>
      )}

      <!-- Links para Instagram ou Website -->
      <div class="flex flex-wrap items-center gap-2">
        {link && (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-950 border border-zinc-800 text-xs font-sans font-medium text-zinc-300 hover:text-orange-500 hover:border-orange-500/40 transition-colors"
            aria-label={`Acessar ${name}`}
          >
            {link.includes('instagram.com') ? (
              <>
                <svg class="w-3.5 h-3.5 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Instagram</span>
              </>
            ) : (
              <>
                <svg class="w-3.5 h-3.5 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                <span>Website</span>
              </>
            )}
          </a>
        )}

        {websiteLink && (
          <a
            href={websiteLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-950 border border-zinc-800 text-xs font-sans font-medium text-zinc-300 hover:text-orange-500 hover:border-orange-500/40 transition-colors"
            aria-label={`Website de ${name}`}
          >
            <svg class="w-3.5 h-3.5 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span>Site</span>
          </a>
        )}
      </div>
    </div>

    <div>
      <h3 class="text-xl sm:text-2xl font-bold font-heading text-white group-hover:text-orange-500 transition-colors tracking-tight mb-2">
        {name}
      </h3>
      {description && (
        <p class="text-sm sm:text-base text-zinc-300 font-sans leading-relaxed">
          {description}
        </p>
      )}
    </div>
  </div>
</div>
