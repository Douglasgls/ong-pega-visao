---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Badge from '../components/common/Badge.astro';
import Button from '../components/common/Button.astro';
import PartnerCard from '../components/sections/PartnerCard.astro';

// Hero Photograph
import imgHeroParcerias from '../assets/grupo-pega-visao.jpg';

const parceiros = [
  {
    name: 'Pão Bom Pra Todo Mundo',
    description: 'Parceiro estratégico na área de gastronomia e formação profissional. Viabiliza as oficinas de panificação artesanal com domínio técnico e apoia na empregabilidade de jovens egressos.'
  },
  {
    name: 'Instituto Responsa',
    description: 'Parceiro institucional com mais de 8 anos de atuação no desenvolvimento humano. Contribui com redes de apoio para a juventude periférica, com capacitação, empregabilidade e apoio socioassistencial.'
  },
  {
    name: 'Fundação CASA',
    description: 'Principal espaço de atuação do Instituto, com presença em mais de 8 centros no Estado de São Paulo.'
  },
  {
    name: 'Veirano Advogados',
    description: 'Apoio Pro Bono para a consolidação institucional e jurídica do Instituto, garantindo estrutura legal sólida para o crescimento do trabalho.'
  }
];
---

<BaseLayout
  title="Parcerias"
  description="Conheça as redes de colaboração e parceiros institucionais do Instituto Pega Visão."
>
  <!-- HERO ELEGANTE COM FOTOGRAFIA GRANDE -->
  <section class="py-20 sm:py-28 bg-zinc-950 border-b border-zinc-800/80 relative overflow-hidden">
    <Container size="lg">
      <div class="max-w-4xl space-y-6 mb-12">
        <div>
          <Badge variant="zinc" size="md">Rede de Impacto</Badge>
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-heading text-white tracking-tight leading-[1.12]">
          Parcerias que fortalecem oportunidades
        </h1>
        <p class="text-lg sm:text-xl text-zinc-300 font-sans leading-relaxed pt-2 border-l-2 border-orange-600 pl-6">
          Construímos pontes entre organizações, empresas, profissionais e comunidades para ampliar oportunidades e fortalecer iniciativas que transformam a vida de crianças, adolescentes e jovens.
        </p>
      </div>

      <!-- Fotografia do Hero -->
      <div class="relative rounded-3xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-2xl group">
        <Image
          src={imgHeroParcerias}
          alt="Parcerias e impacto coletivo — Instituto Pega Visão"
          class="w-full h-[360px] sm:h-[480px] lg:h-[540px] object-cover object-center transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
      </div>
    </Container>
  </section>

  <!-- INTRODUÇÃO BREVE (TRABALHO EM REDE) -->
  <section class="py-20 sm:py-24 bg-zinc-950">
    <Container size="lg">
      <div class="max-w-3xl space-y-4">
        <div>
          <Badge variant="zinc" size="sm">Trabalho em Rede</Badge>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-white tracking-tight">
          Colaboração e Impacto Territorial
        </h2>
        <p class="text-base sm:text-lg text-zinc-300 font-sans leading-relaxed">
          Acreditamos que o trabalho em rede é a forma mais sólida de gerar transformações duradouras. Cada parceria une conhecimentos, recursos e esforços para fortalecer a atuação direta nos territórios.
        </p>
      </div>
    </Container>
  </section>

  <!-- SEÇÃO DE PARCEIROS (GRID 2 COLUNAS NO DESKTOP, SEM LOGOS/ÍCONES) -->
  <section class="py-20 sm:py-28 bg-zinc-900/30 border-t border-zinc-800/80">
    <Container size="lg">
      <div class="max-w-3xl mb-14 space-y-3">
        <Badge variant="zinc" size="sm">Nossos Apoiadores</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold font-heading text-white tracking-tight">
          Instituições e Organizações Parceiras
        </h2>
      </div>

      <!-- Grid: 2 Colunas no Desktop, 1 no Mobile -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        {parceiros.map((parceiro) => (
          <PartnerCard
            name={parceiro.name}
            description={parceiro.description}
          />
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA FINAL: CONVITE PARA NOVAS PARCERIAS (REDIRECIONA COM QUERY PARAM) -->
  <section class="py-24 sm:py-32 bg-zinc-950 border-t border-zinc-800/80 relative overflow-hidden">
    <Container size="lg">
      <div class="bg-gradient-to-r from-zinc-900 via-zinc-900 to-zinc-950 border border-zinc-800/80 rounded-3xl p-8 sm:p-14 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 shadow-2xl">
        <div class="max-w-2xl space-y-4">
          <Badge variant="zinc" size="sm">Construa Conosco</Badge>
          <h2 class="text-3xl sm:text-4xl font-bold font-heading text-white tracking-tight leading-tight">
            Quer ser parceiro?
          </h2>
          <p class="text-base sm:text-lg text-zinc-300 font-sans leading-relaxed">
            Organizações, empresas, parlamentares e personalidades públicas que compartilham nossos valores são bem-vindos para construir iniciativas conjuntas em prol da juventude periférica.
          </p>
        </div>

        <div class="flex-shrink-0">
          <Button href="/contato?assunto=nova-parceria" variant="primary" size="lg">
            Propor Parceria
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
