---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Container from '../components/common/Container.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import { siteData } from '../data/siteData';
---

<BaseLayout
  title="Contato"
  description="Fale com a equipe do Instituto Pega a Visão. Canais de atendimento, endereço e formulário de mensagem."
>
  <PageHero
    badge="Fale Conosco"
    title="Canais de Contato"
    description="Quer propor uma parceria, tirar dúvidas ou agendar uma visita? Envie uma mensagem ou entre em contato pelos nossos canais diretos."
  />

  <section class="py-24 sm:py-32 bg-zinc-950">
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left: Contact Details -->
        <div class="lg:col-span-5 space-y-8">
          <SectionTitle
            badge="Atendimento Direto"
            title="Estamos Prontos para Ouvir Você"
          />

          <div class="space-y-4">
            <div class="flex items-start gap-4 p-5 bg-zinc-900/60 border border-zinc-800/80 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-orange-950/60 border border-orange-600/40 flex items-center justify-center text-orange-400 flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h4 class="text-base font-bold font-heading text-white">Localização</h4>
                <p class="text-sm text-zinc-400 font-sans mt-1">{siteData.contact.address}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-zinc-900/60 border border-zinc-800/80 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-orange-950/60 border border-orange-600/40 flex items-center justify-center text-orange-400 flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="text-base font-bold font-heading text-white">E-mail Institucional</h4>
                <a href={`mailto:${siteData.contact.email}`} class="text-sm text-orange-400 hover:underline font-sans mt-1 block">
                  {siteData.contact.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-zinc-900/60 border border-zinc-800/80 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-orange-950/60 border border-orange-600/40 flex items-center justify-center text-orange-400 flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <a href={siteData.contact.instagram} target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-400 hover:text-orange-400 transition-colors font-sans mt-1 block">
                  Acompanhe nossas ações diárias no Instagram @i.pegavisao
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </Container>
  </section>
</BaseLayout>
