---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import Badge from "../components/common/Badge.astro";
import TeamMemberCard from "../components/sections/TeamMemberCard.astro";

// Photos from assets/equipe/
import imgAlinne from "../assets/equipe/alinne.jpg";
import imgMilhem from "../assets/equipe/Milhem-Cortaz_FCASA-68-1024x683.jpg";
import imgDebora from "../assets/equipe/debora.png";
import imgChaleks from "../assets/equipe/mc_chaleks.jpg";
import imgRk9 from "../assets/equipe/rk9_image_5_300x300.png";
import imgKarine from "../assets/equipe/karine_image_4_300x300.png";
import imgMarcelo from "../assets/equipe/marcelo_image_3_300x300.png";
import imgLucas from "../assets/equipe/lucas_image_6_300x300.png";
import imgJow from "../assets/equipe/jow_image-8-300x300.png";

// Photos from assets/voluntarios/
import imgMcFilhote from "../assets/voluntarios/mc_fiote_image_7_300x300.png";
import imgMatheus from "../assets/voluntarios/matheus_image-9-300x300.png";
import imgThiagsson from "../assets/voluntarios/Thiagsson_Chaleks_002-2-300x225.jpeg";
import imgChefEdson from "../assets/voluntarios/chef_edson_leite_GP_003-300x225.jpeg";
import imgNayara from "../assets/voluntarios/nayara_image-10-300x300.png";
import imgJaco from "../assets/voluntarios/jaco_image-14-300x300.png";

const voluntarios = [
  { name: "Mc Filhote", image: imgMcFilhote },
  { name: "Matheus Santos", image: imgMatheus },
  { name: "Thiagsson", image: imgThiagsson },
  { name: "Chef Edson Leite", image: imgChefEdson },
  { name: "Nayara Capello", image: imgNayara },
  { name: "Jacó", image: imgJaco },
];
---

<BaseLayout
  title="Equipe"
  description="Conheça quem corre com o Instituto Pega Visão. Lideranças, educadores e articuladores comunitários."
>
  <!-- HERO SIMPLES E ELEGANTE -->
  <section
    class="py-24 sm:py-32 bg-zinc-950 border-b border-zinc-800/80 relative overflow-hidden"
  >
    <Container size="lg">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center pb-12"
      >
        <!-- Texto Hero -->
        <div class="lg:col-span-7 space-y-6">
          <div>
            <Badge variant="zinc" size="md">Nossas Lideranças</Badge>
          </div>
          <h1
            class="text-3xl sm:text-5xl lg:text-6xl font-bold font-heading text-white tracking-tight leading-[1.12]"
          >
            Quem Corre com o Pega Visão
          </h1>
          <p
            class="text-lg sm:text-xl text-zinc-300 font-sans leading-relaxed pt-2 border-l-2 border-orange-600 pl-6"
          >
            Um time movido por propósito, conexão com as comunidades e vontade
            de gerar mudanças reais.
          </p>
        </div>
      </div>
    </Container>

    <!-- SEÇÃO DE INTEGRANTES DA EQUIPE (COMPOSIÇÃO EDITORIAL) -->
    <section class="py-24 sm:py-32 bg-zinc-900/30 border-t border-zinc-800/80">
      <Container size="lg">
        <div class="max-w-3xl mb-16 space-y-3">
          <Badge variant="zinc" size="sm">Pessoas que Fazem Acontecer</Badge>
          <h2
            class="text-3xl sm:text-4xl font-bold font-heading text-white tracking-tight"
          >
            Nossa Equipe
          </h2>
        </div>

        <!-- Grid Editorial de Integrantes -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- 1. Alinne Almeida -->
          <TeamMemberCard
            name="Alinne Almeida"
            role="Fundadora & Presidente"
            bio="Gestão com propósito: +10 anos criando projetos e, desde 2022, abrindo caminhos para jovens da Fundação CASA com diversidade e inclusão."
            image={imgAlinne}
            socialLinks={{
              linkedin: "https://www.linkedin.com/alinnealmeida",
              instagram: "https://instagram.com/i.pegavisao",
            }}
          />

          <!-- 2. Milhem Cortaz -->
          <TeamMemberCard
            name="Milhem Cortaz"
            role="Fundador & Vice Presidente"
            bio="Ator & Padeiro, apaixonado pela arte como ferramenta de inclusão. Transformando vidas com afeto, pão e oportunidades."
            image={imgMilhem}
            socialLinks={{
              instagram: "https://www.instagram.com/cortaz",
            }}
          />

          <!-- 3. Débora Antunes -->
          <TeamMemberCard
            name="Débora Antunes"
            role="Fundadora & Diretora"
            bio="Liderança que faz acontecer: conecta comunidades, fortalece projetos sociais e amplia oportunidades para jovens e famílias."
            image={imgDebora}
          />

          <!-- 4. MC Chaleks -->
          <TeamMemberCard
            name="MC Chaleks"
            role="Co-Fundador & Coordenador"
            bio="Artista da cena do funk consciente e rap/trap ligado à região do ABC Paulista (São Paulo)."
            image={imgChaleks}
            socialLinks={{
              instagram: "https://www.instagram.com/chaleks_mc",
            }}
          />

          <!-- 5. Ronaldo RK9 -->
          <TeamMemberCard
            name="Ronaldo RK9"
            role="Co-Fundador & Educador"
            bio="Adestrador Canino Internacional, Cinotécnico, Responsável pelos Dogs de Comerciais e Séries Netflix."
            image={imgRk9}
            socialLinks={{
              instagram: "https://www.instagram.com/eusourk9",
            }}
          />

          <!-- 6. Karine Vieira -->
          <TeamMemberCard
            name="Karine Vieira"
            role="Assistente Social Voluntária"
            bio="CEO do Instituto Responsa, Parceira do Pega Visão & Assistente Social Voluntária."
            image={imgKarine}
            socialLinks={{
              instagram: "https://www.instagram.com/responsapro",
            }}
          />

          <!-- 7. Marcelo Liotti -->
          <TeamMemberCard
            name="Marcelo Liotti"
            role="Psicólogo Voluntário"
            bio="Psicólogo Especialista em infância e juventude"
            image={imgMarcelo}
          />

          <!-- 8. Lucas Bastos -->
          <TeamMemberCard
            name="Lucas Bastos"
            role="Psicólogo Voluntário"
            bio="Psicólogo Especialista em Juventude"
            image={imgLucas}
          />

          <!-- 9. Jow William -->
          <TeamMemberCard
            name="Jow William"
            role="VideoMaker"
            bio="Fotográfo & VideoMaker Voluntário"
            image={imgJow}
            socialLinks={{
              instagram: "https://www.instagram.com/eowjow",
            }}
          />
        </div>
      </Container>
    </section>

    <!-- SEÇÃO DE VOLUNTÁRIOS -->
    <section class="py-24 sm:py-32 bg-zinc-950 border-t border-zinc-800/80">
      <Container size="lg">
        <div class="max-w-3xl mb-16 space-y-3">
          <Badge variant="zinc" size="sm">Apoio & Colaboração</Badge>
          <h2
            class="text-3xl sm:text-4xl font-bold font-heading text-white tracking-tight"
          >
            Voluntários
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {voluntarios.map((voluntario) => (
            <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl overflow-hidden group hover:border-orange-500/40 hover:shadow-2xl hover:shadow-orange-500/5 transition-all duration-500 flex flex-col">
              <div class="relative h-64 sm:h-72 w-full overflow-hidden bg-zinc-950">
                <Image
                  src={voluntario.image}
                  alt={voluntario.name}
                  class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                />
              </div>
              <div class="py-3 px-4 text-center">
                <h3 class="text-base sm:text-lg font-bold font-heading text-white tracking-tight">
                  {voluntario.name}
                </h3>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- INTRODUÇÃO INSTITUCIONAL -->
    <section class="py-24 sm:py-32 bg-zinc-900/30 border-t border-zinc-800/80">
      <Container size="lg">
        <div class="max-w-4xl space-y-8">
          <div>
            <Badge variant="zinc" size="sm">Propósito Coletivo</Badge>
          </div>

          <h2
            class="text-3xl sm:text-5xl font-bold font-heading text-white tracking-tight leading-tight"
          >
            Pega Visão
          </h2>

          <div
            class="space-y-6 text-base sm:text-lg text-zinc-300 font-sans leading-relaxed border-t border-zinc-800/80 pt-8"
          >
            <p>
              Somos construídos coletivamente por pessoas periféricas,
              sobreviventes do cárcere e do sistema socioeducativo, e por
              familiares comprometidos com os direitos de crianças e
              adolescentes.
            </p>
            <p>
              Nossa missão, valores e princípios são a base de tudo o que
              fazemos. Eles guiam cada projeto, cada parceria e cada
              oportunidade criada para transformar vidas por meio da arte, da
              cultura e da educação.
            </p>
          </div>
        </div>
      </Container>
    </section>
  </section>
</BaseLayout>
